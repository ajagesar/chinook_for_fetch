### --- only include certain files --- ###

# ignore everything
*

# Allow gitignore
!*.gitignore

# Allow directories
!*/

# Allow certain file types
!*.py
!*.yaml
!*.yml
!*.md
!*.lock
!*.toml

### --- exclude below --- ### (Redundant with the above, but still noted for reference. Also includes specific folders)

# Ignore CSV files
*.csv

# Ignore Jupyter Notebook files
*.ipynb
*.pyc
*.txt

# ignore images as output
*.png
*.jpeg

# Ignore .venv
.venv/

# Ignore egg info
*.egg-info/

# Ignore __pycache__/
__pycache__/

# ignore databases
*.duckdb

# ignore archive and data folders
archive/
data/4